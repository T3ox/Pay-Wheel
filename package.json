{
  "name": "pay-wheel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "functions",
    "packages/domain"
  ],
  "scripts": {
    "dev": "npm run dev -w @pay-wheel/web",
    "build": "npm run build -w @pay-wheel/domain && npm run build -w @pay-wheel/functions && npm run build -w @pay-wheel/web",
    "preview": "npm run preview -w @pay-wheel/web",
    "lint": "eslint .",
    "typecheck": "npm run build -w @pay-wheel/domain && npm run typecheck -w @pay-wheel/functions && npm run typecheck -w @pay-wheel/web",
    "test": "npm run test -w @pay-wheel/domain && npm run test -w @pay-wheel/web && npm run test -w @pay-wheel/functions",
    "test:rules": "npm run test:rules -w @pay-wheel/functions",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "emulators": "firebase emulators:start --import=.firebase-data --export-on-exit=.firebase-data"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.34.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
